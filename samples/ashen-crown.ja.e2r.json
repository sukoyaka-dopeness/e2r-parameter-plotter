    "metadata": {
      "datasetId": "ashen-crown-ja-v1",
      "title": "灰冠の王国"
    },
    "draft.github.sukoyaka-dopeness.dimension-assessment": {
      "specVersion": "0.2.0",
      "dimensions": [
        {
          "id": "ashen.command",
          "name": "指揮権限",
          "min": 0,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "指揮権限なし",
          "highLabel": "王国規模の指揮権限",
          "description": "このDatasetに描かれた物語全体を通じて、人々や組織を指揮する権限を評価します。0は尺度上の最低値で、指揮権限がない状態、6は王国の行方を左右する規模の指揮権限を表します。"
        },
        {
          "id": "ashen.combat",
          "name": "戦闘能力",
          "min": 0,
          "max": 10,
          "integerOnly": true,
          "lowLabel": "戦闘能力なし",
          "highLabel": "卓越した戦闘能力",
          "description": "このDatasetに描かれた物語全体を通じて、直接戦闘を行う能力を評価します。0は尺度上の最低値で、戦闘能力がない状態、10は直接対決で卓越した力を発揮する状態を表します。"
        },
        {
          "id": "ashen.information",
          "name": "情報活用力",
          "min": 0,
          "max": 8,
          "integerOnly": true,
          "lowLabel": "情報活用力なし",
          "highLabel": "王国規模の事態を動かす情報活用力",
          "description": "このDatasetに描かれた物語全体を通じて、重要な情報を活用し、事態に影響を与える力を評価します。0は尺度上の最低値で、情報による影響力がない状態、8は王国規模の事態を動かせる状態を表します。"
        },
        {
          "id": "ashen.arcane",
          "name": "魔術的な力",
          "min": 0,
          "max": 12,
          "integerOnly": true,
          "lowLabel": "魔術的な力なし",
          "highLabel": "王国の運命を変える魔術的な力",
          "description": "このDatasetに描かれた物語全体を通じて、超常的・魔術的な力を評価します。0は尺度上の最低値で、その力を持たない状態、12は王国の運命を変え得る力を表します。"
        },
        {
          "id": "ashen.healing",
          "name": "治療能力",
          "min": 0,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "治療の技術なし",
          "highLabel": "卓越した治療能力",
          "description": "このDatasetに描かれた物語全体を通じて、負傷や病を治療する技術を評価します。0は尺度上の最低値で、治療の技術がない状態、6は卓越した治療能力を表します。"
        },
        {
          "id": "ashen.diplomacy",
          "name": "交渉力",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "交渉が不得手",
          "highLabel": "卓越した交渉力",
          "description": "このDatasetに描かれた物語全体を通じて、交渉や駆け引きの能力を評価します。和平に用いるか、政治的策略や分裂に用いるかは評価しません。0は尺度上の最低値、5は卓越した交渉能力を表します。"
        },
        {
          "id": "ashen.concord",
          "name": "和議への貢献",
          "min": -4,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "分裂を深める",
          "highLabel": "長く続く和議を築く",
          "description": "このDatasetに描かれた物語全体を通じて、和解や共同体のまとまりに与える総合的な影響を評価します。負の値は分裂を深め、0は中立的な総合影響、正の値は長く続く和議への貢献を表します。"
        }
      ],
