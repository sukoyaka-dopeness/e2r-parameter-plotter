    "draft.github.sukoyaka-dopeness.dimension-assessment": {
      "specVersion": "0.2.0",
      "dimensions": [
        {
          "id": "ashen.command",
          "name": "Command Authority",
          "min": 0,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "No command authority",
          "highLabel": "Realm-scale command",
          "description": "Rates the authority to direct people or organized groups across the story represented in this Dataset. 0 is the scale minimum: no command authority; 6 is command authority capable of shaping the realm's course."
        },
        {
          "id": "ashen.combat",
          "name": "Combat Capability",
          "min": 0,
          "max": 10,
          "integerOnly": true,
          "lowLabel": "No combat capability",
          "highLabel": "Exceptional combatant",
          "description": "Rates direct combat capability across the story represented in this Dataset. 0 is the scale minimum: no combat capability; 10 is exceptional capability in direct conflict."
        },
        {
          "id": "ashen.information",
          "name": "Information Leverage",
          "min": 0,
          "max": 8,
          "integerOnly": true,
          "lowLabel": "No information leverage",
          "highLabel": "Can redirect realm events",
          "description": "Rates access to consequential information and the ability to use it to influence events across the story represented in this Dataset. 0 is the scale minimum: no information leverage; 8 can redirect events across the realm."
        },
        {
          "id": "ashen.arcane",
          "name": "Arcane Power",
          "min": 0,
          "max": 12,
          "integerOnly": true,
          "lowLabel": "No arcane power",
          "highLabel": "World-shaping power",
          "description": "Rates supernatural or arcane power across the story represented in this Dataset. 0 is the scale minimum: no arcane power; 12 is power capable of changing the realm's fate."
        },
        {
          "id": "ashen.healing",
          "name": "Healing Practice",
          "min": 0,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "No healing practice",
          "highLabel": "Master healer",
          "description": "Rates the skill to treat injury or illness across the story represented in this Dataset. 0 is the scale minimum: no healing practice; 6 is exceptional restorative skill."
        },
        {
          "id": "ashen.diplomacy",
          "name": "Diplomatic Skill",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "Ineffective negotiator",
          "highLabel": "Exceptional negotiator",
          "description": "Rates negotiation and tactical bargaining ability across the story represented in this Dataset. It measures skill, not whether that skill is used for peace, political strategy, or division. 0 is the scale minimum; 5 is exceptional negotiating ability."
        },
        {
          "id": "ashen.concord",
          "name": "Contribution to Concord",
          "min": -4,
          "max": 6,
          "integerOnly": true,
          "lowLabel": "Deepens division",
          "highLabel": "Builds lasting concord",
          "description": "Rates the net effect on unity and settlement across the whole story represented in this Dataset. Negative values deepen division, 0 is a neutral overall effect, and positive values contribute to lasting concord."
        }
      ],
